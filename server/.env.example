# 이 파일을 복사해 ".env" 로 저장한 뒤 값을 채우세요. (.env 는 절대 공유/업로드 금지)

# ── 어떤 LLM으로 분석할지 선택 ──
#   gemini (기본)  또는  openai (GPT)
# openai 로 두면 아래 OPENAI_API_KEY 를 사용해 GPT로 분석합니다. (프론트 수정 불필요)
LLM_PROVIDER=gemini

# ── Gemini 사용 시 ──
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 Gemini API 키
GEMINI_API_KEY=여기에_발급받은_키_붙여넣기

# 사용할 모델 (선택). 기본 gemini-3.6-flash (빠르고 안정적).
# 최신 모델이 과부하일 때가 있어, 안정 버전을 기본값으로 둡니다. 필요시 교체 가능.
GEMINI_MODEL=gemini-3.6-flash

# ── GPT(OpenAI) 사용 시 ──  (LLM_PROVIDER=openai 로 바꾼 뒤 아래 두 값 입력)
# OpenAI 플랫폼(https://platform.openai.com/api-keys)에서 발급한 키
# OPENAI_API_KEY=sk-...
# 사용할 모델 (선택). 기본 gpt-4o-mini (저렴/빠름). 더 좋은 품질은 gpt-4o.
# OPENAI_MODEL=gpt-4o-mini

# 서버 포트 (선택)
PORT=3000

# 프론트와 백엔드를 다른 도메인에 배포할 때만 설정 (예: https://내도메인.com)
# ALLOWED_ORIGIN=https://내도메인.com

# ── 2단계: 로그인 검증 (Supabase) ──
# 아래 두 값을 넣으면 로그인한 상담사만 AI를 호출할 수 있어 Gemini 키 남용을 막습니다.
# (public/config.js 에 넣는 값과 동일합니다. Supabase > Settings > API)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...

# 보험 공시 조회: 공공데이터포털의 두 API를 활용 신청한 일반 인증키(Decoding).
# DATA_GO_KR_SERVICE_KEY=
# 선택: 이전 수집 결과를 재시작 후에도 유지할 PostgreSQL 연결 문자열.
# INSURANCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
